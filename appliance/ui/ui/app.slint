export struct EpisodeData {
    id: string,
    title: string,
    subtitle: string,
    art: image,
    has-art: bool,
    watched: bool,
    /// 0..1 of the way through, for the resume bar.
    progress: float,
}

export struct TileData {
    id: string,
    kind: string,
    title: string,
    subtitle: string,
    art: image,
    has-art: bool,
}

export struct RowData {
    label: string,
    tiles: [TileData],
}

component Poster inherits Rectangle {
    in property <TileData> data;
    in property <bool> focused;
    in property <int> index;
    width: 200px;
    height: 300px;
    border-radius: 10px;
    clip: true;
    // A stable colour per position when there is no artwork.
    background: Colors.hsv(mod(index * 47, 360), 0.45, 0.35);

    if data.has-art: Image {
        source: data.art;
        width: parent.width;
        height: parent.height;
        image-fit: cover;
    }
    if !data.has-art: Text {
        text: data.title;
        wrap: word-wrap;
        font-size: 24px;
        color: white;
        width: parent.width - 24px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// A line icon drawn from SVG path commands on a 24x24 grid (no icon font needed).
component Glyph inherits Path {
    in property <color> tint: white;
    width: 40px;
    height: 40px;
    viewbox-width: 24;
    viewbox-height: 24;
    fill: transparent;
    stroke: tint;
    stroke-width: 1.8px;
    stroke-line-cap: round;
}

// One bar button: a glyph in a rounded square; yellow ring when focused, red when armed.
component BarButton inherits Rectangle {
    in property <bool> focused;
    in property <bool> armed;
    in property <string> commands;
    width: 60px;
    height: 60px;
    border-radius: 14px;
    background: armed ? #b3261e : (focused ? #26323d : transparent);
    border-width: focused ? 4px : 0px;
    border-color: #ffd54a;
    Glyph {
        commands: root.commands;
        tint: root.focused || root.armed ? white : #7d8892;
    }
}

export component App inherits Window {
    in property <[RowData]> rows;
    in-out property <int> sel-row: 0;
    in-out property <int> sel-col: 0;
    callback activate(int, int);
    callback quit();
    callback moved();
    callback power(string);
    callback arm(string);
    callback disarm(string, string);
    callback config();
    // The show or channel page: season tabs (detail-focus 0) over the episodes of one season (1).
    in property <bool> detail;
    in property <string> detail-title;
    in-out property <string> detail-id: "";
    in property <[string]> seasons;
    in property <[EpisodeData]> episodes;
    in-out property <int> sel-season: 0;
    in-out property <int> sel-ep: 0;
    in-out property <int> detail-focus: 0;
    callback season-changed(int);
    callback play-episode(int);
    callback back();
    // The watched-toggle menu: one entry ("Mark watched"/"Mark unwatched").
    in property <bool> menu-open: false;
    in property <string> menu-title: "";
    in property <string> menu-action: "";
    callback menu();
    callback menu-activate();
    callback menu-close();
    // Debug builds log every remote button the UI receives (the text of the key event).
    callback key-debug(string);
    // sel-row == -1 puts the focus on the top bar; bar-sel picks the button (0 settings, 1 reboot,
    // 2 shutdown). Reboot and shutdown need a second select ("armed") within 3 s.
    in-out property <int> bar-sel: 0;
    property <int> armed: -1;
    property <string> notice;

    background: #0e1318;
    forward-focus: fs;
    default-font-size: 22px;

    property <length> tile-w: 224px;
    property <length> row-h: 480px;

    function clamp-col() {
        sel-col = max(0, min(sel-col, rows[sel-row].tiles.length - 1));
    }

    // True while the top bar (settings, reboot, shutdown) has the focus, on either screen.
    property <bool> on-bar: detail ? detail-focus < 0 : sel-row < 0;

    // Back goes up one level: episodes -> season tabs -> the show list; from the top bar it
    // returns to the page below it. On the show list there is nowhere further up.
    public function go-back() {
        disarm-power("button");
        if (menu-open) { menu-close(); return; }
        if (detail) {
            if (detail-focus == 1) { detail-focus = 0; moved(); }
            else if (detail-focus < 0) { detail-focus = 0; moved(); }
            else { back(); moved(); }
        } else if (sel-row < 0) {
            if (rows.length > 0) { sel-row = 0; clamp-col(); moved(); }
        }
    }

    // Home goes to the top of the tree: out of any show page, onto the first row.
    public function go-home() {
        disarm-power("button");
        if (menu-open) { menu-close(); return; }
        if (detail) { back(); }
        sel-row = rows.length > 0 ? 0 : -1;
        sel-col = 0;
        moved();
    }

    function disarm-power(why: string) {
        if (armed >= 0) { disarm(armed == 1 ? "reboot" : "poweroff", why); }
        armed = -1;
    }

    function bar-move(step: int) {
        if (bar-sel + step >= 0 && bar-sel + step <= 2) { bar-sel += step; moved(); }
    }

    function bar-activate() {
        if (bar-sel == 0) {
            notice = "Settings are not built yet";
            notice-timer.running = true;
            config();
        } else if (armed == bar-sel) {
            armed = -1;
            power(bar-sel == 1 ? "reboot" : "poweroff");
        } else {
            armed = bar-sel;
            arm(bar-sel == 1 ? "reboot" : "poweroff");
            arm-timer.running = true;
        }
    }

    fs := FocusScope {
        key-pressed(e) => {
            key-debug(e.text);
            // Reboot and shutdown need a second select; any other button cancels.
            if (e.text != Key.Return && armed >= 0) { disarm-power("button"); }
            if (menu-open) {
                if (e.text == Key.Return) { menu-activate(); }
                else { menu-close(); }
                return accept;
            }
            if (e.text == Key.Home) { go-home(); return accept; }
            if (e.text == Key.Backspace) { go-back(); return accept; }
            if (detail) {
                if (e.text == Key.LeftArrow) {
                    if (on-bar) { bar-move(-1); }
                    else if (detail-focus == 0) {
                        if (sel-season > 0) { sel-season -= 1; season-changed(sel-season); moved(); }
                    } else if (sel-ep > 0) { sel-ep -= 1; moved(); }
                } else if (e.text == Key.RightArrow) {
                    if (on-bar) { bar-move(1); }
                    else if (detail-focus == 0) {
                        if (sel-season < seasons.length - 1) { sel-season += 1; season-changed(sel-season); moved(); }
                    } else if (sel-ep < episodes.length - 1) { sel-ep += 1; moved(); }
                } else if (e.text == Key.DownArrow) {
                    if (on-bar) { detail-focus = 0; moved(); }
                    else if (detail-focus == 0 && episodes.length > 0) { detail-focus = 1; moved(); }
                } else if (e.text == Key.UpArrow) {
                    if (detail-focus == 1) { detail-focus = 0; moved(); }
                    else if (detail-focus == 0) { detail-focus = -1; moved(); }
                } else if (e.text == Key.Return) {
                    if (on-bar) { bar-activate(); }
                    else if (detail-focus == 1) { play-episode(sel-ep); }
                    else if (episodes.length > 0) { detail-focus = 1; moved(); }
                } else if (e.text == Key.Escape) {
                    go-back();
                } else {
                    return reject;
                }
                return accept;
            }
            if (e.text == Key.RightArrow) {
                if (sel-row < 0) { bar-move(1); }
                else if (sel-col < rows[sel-row].tiles.length - 1) { sel-col += 1; moved(); }
            } else if (e.text == Key.LeftArrow) {
                if (sel-row < 0) { bar-move(-1); }
                else if (sel-col > 0) { sel-col -= 1; moved(); }
            } else if (e.text == Key.DownArrow) {
                if (sel-row < 0) {
                    if (rows.length > 0) { sel-row = 0; clamp-col(); moved(); }
                } else if (sel-row < rows.length - 1) { sel-row += 1; clamp-col(); moved(); }
            } else if (e.text == Key.UpArrow) {
                if (sel-row >= 0) { sel-row -= 1; moved(); }
            } else if (e.text == Key.Return) {
                if (sel-row >= 0) { activate(sel-row, sel-col); } else { bar-activate(); }
            } else if (e.text == Key.Escape) {
                quit();
            } else {
                return reject;
            }
            accept
        }
    }

    arm-timer := Timer {
        running: false;
        interval: 3s;
        triggered => {
            if (armed >= 0) { disarm(armed == 1 ? "reboot" : "poweroff", "timeout"); }
            armed = -1;
            self.running = false;
        }
    }
    notice-timer := Timer {
        running: false;
        interval: 2500ms;
        triggered => { notice = ""; self.running = false; }
    }

    // Top bar: glyph buttons on the right, a short notice on the left.
    Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: 80px;
        background: #121a21;
        // The wordmark, in a streaming-service red: heavy, widely spaced, with a dark offset
        // shadow for the embossed look. Hebrew, reading right to left.
        Text {
            x: 62px;
            y: 3px;
            text: "שמטפליקס";
            font-size: 46px;
            font-weight: 900;
            letter-spacing: 3px;
            color: #5c0a0e;
            vertical-alignment: center;
            height: parent.height;
        }
        Text {
            x: 60px;
            text: "שמטפליקס";
            font-size: 46px;
            font-weight: 900;
            letter-spacing: 3px;
            color: #e50914;
            vertical-alignment: center;
            height: parent.height;
        }
        Text {
            x: 330px;
            text: notice;
            font-size: 22px;
            color: #aab4bd;
            vertical-alignment: center;
            height: parent.height;
        }
        HorizontalLayout {
            x: root.width - 212px - 60px;
            y: 10px;
            width: 212px;
            height: 60px;
            spacing: 16px;
            BarButton {
                focused: on-bar && bar-sel == 0;
                // sliders
                commands: "M4 7 H6 M10 7 H20 M8 7 m-2 0 a2 2 0 1 0 4 0 a2 2 0 1 0 -4 0 M4 12 H14 M18 12 H20 M16 12 m-2 0 a2 2 0 1 0 4 0 a2 2 0 1 0 -4 0 M4 17 H8 M12 17 H20 M10 17 m-2 0 a2 2 0 1 0 4 0 a2 2 0 1 0 -4 0";
            }
            BarButton {
                focused: on-bar && bar-sel == 1;
                armed: armed == 1;
                // circular arrow
                commands: "M20 12 A8 8 0 1 1 17.66 6.34 M20 3.5 V8.5 H15";
            }
            BarButton {
                focused: on-bar && bar-sel == 2;
                armed: armed == 2;
                // power
                commands: "M12 3 V12 M7.2 6.2 A8 8 0 1 0 16.8 6.2";
            }
        }
    }

    // Show / channel page: the title, season tabs, then that season's episodes with thumbnails.
    if detail: Rectangle {
        x: 0;
        y: 80px;
        width: root.width;
        height: root.height - 80px;
        clip: true;

        Text {
            x: 60px;
            y: 24px;
            width: root.width - 120px;
            text: detail-title;
            font-size: 40px;
            font-weight: 700;
            color: white;
            overflow: elide;
        }
        Rectangle {
            x: 0;
            y: 96px;
            width: root.width;
            height: 56px;
            clip: true;
            for s[i] in seasons: Rectangle {
                x: 60px + (i - max(0, sel-season - 6)) * 190px;
                width: 176px;
                height: 52px;
                border-radius: 26px;
                background: i == sel-season ? (detail-focus == 0 ? #ffd54a : #38444f) : transparent;
                animate x { duration: 150ms; easing: ease-out; }
                Text {
                    text: s;
                    font-size: 24px;
                    font-weight: 600;
                    color: i == sel-season ? (detail-focus == 0 ? #0e1318 : white) : #7d8892;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: parent.width;
                    height: parent.height;
                }
            }
        }
        Rectangle {
            x: 60px - max(0, sel-ep - 3) * 360px;
            y: 190px;
            animate x { duration: 180ms; easing: ease-out; }
            for ep[ei] in episodes: Rectangle {
                x: ei * 360px;
                y: 0px;
                width: 360px;
                height: 330px;
                property <bool> focused: detail-focus == 1 && ei == sel-ep;
                Rectangle {
                    x: 8px;
                    y: parent.focused ? 4px : 10px;
                    width: 336px;
                    height: 189px;
                    border-radius: 10px;
                    clip: true;
                    background: Colors.hsv(mod(ei * 47, 360), 0.45, 0.35);
                    animate y { duration: 120ms; }
                    if ep.has-art: Image {
                        source: ep.art;
                        width: parent.width;
                        height: parent.height;
                        image-fit: cover;
                    }
                    if !ep.has-art: Text {
                        text: ep.title;
                        wrap: word-wrap;
                        font-size: 22px;
                        color: white;
                        width: parent.width - 24px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    if ep.progress > 0 && !ep.watched: Rectangle {
                        y: parent.height - 6px;
                        height: 6px;
                        width: parent.width * ep.progress;
                        background: #ffd54a;
                    }
                    if ep.watched: Rectangle {
                        x: parent.width - 44px;
                        y: 8px;
                        width: 34px;
                        height: 34px;
                        border-radius: 17px;
                        background: #000000a0;
                        Text { text: "✓"; color: white; font-size: 22px; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }
                Rectangle {
                    x: 4px;
                    y: parent.focused ? 0px : 6px;
                    width: 344px;
                    height: 197px;
                    border-radius: 14px;
                    border-width: parent.focused ? 5px : 0px;
                    border-color: #ffd54a;
                }
                Text {
                    x: 12px;
                    y: 214px;
                    width: 330px;
                    text: ep.title;
                    font-size: 22px;
                    wrap: word-wrap;
                    overflow: elide;
                    max-height: 64px;
                    color: parent.focused ? white : #aab4bd;
                }
                Text {
                    x: 12px;
                    y: 284px;
                    width: 330px;
                    text: ep.subtitle;
                    font-size: 18px;
                    color: #6f7b86;
                }
            }
        }
    }

    // Rows scroll inside a clipped viewport so only the focused row and the ones below show.
    if !detail: Rectangle {
        x: 0;
        y: 80px;
        width: root.width;
        height: root.height - 80px;
        clip: true;
    Rectangle {
        x: 0;
        y: -max(0, sel-row) * row-h;
        animate y { duration: 180ms; easing: ease-out; }
        for r[ri] in rows: Rectangle {
            y: ri * row-h;
            height: row-h;
            width: root.width;

            Text {
                x: 60px;
                y: 0px;
                text: r.label;
                font-size: 34px;
                font-weight: 700;
                color: ri == sel-row ? white : #7d8892;
            }
            Rectangle {
                x: 60px - max(0, sel-col - 6) * tile-w * (ri == sel-row ? 1 : 0);
                y: 60px;
                height: row-h - 60px;
                animate x { duration: 180ms; easing: ease-out; }
                for t[ti] in r.tiles: Rectangle {
                    x: ti * tile-w;
                    y: 0px;
                    width: tile-w;
                    height: row-h - 60px;
                    property <bool> focused: ri == sel-row && ti == sel-col;
                    Poster {
                        x: 12px;
                        y: parent.focused ? 4px : 10px;
                        data: t;
                        index: ti;
                        focused: parent.focused;
                        animate y { duration: 120ms; }
                    }
                    Rectangle {
                        x: 8px;
                        y: 6px - (parent.focused ? 4px : 0px);
                        width: 208px;
                        height: 308px;
                        border-radius: 14px;
                        border-width: parent.focused ? 5px : 0px;
                        border-color: #ffd54a;
                    }
                    Text {
                        x: 12px;
                        y: 318px;
                        width: 200px;
                        text: t.title;
                        font-size: 22px;
                        wrap: word-wrap;
                        overflow: elide;
                        max-height: 64px;
                        color: parent.focused ? white : #aab4bd;
                    }
                    Text {
                        x: 12px;
                        y: 384px;
                        width: 200px;
                        text: t.subtitle;
                        font-size: 18px;
                        color: #6f7b86;
                    }
                }
            }
        }
    }
    }

    // Watched-toggle menu: a modal single-entry dialog. Enter selects; anything
    // else closes it.
    if menu-open: Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        background: #00000080;
        Rectangle {
            x: (root.width - 560px) / 2;
            y: (root.height - 220px) / 2;
            width: 560px;
            height: 220px;
            border-radius: 20px;
            background: #16202a;
            border-width: 2px;
            border-color: #2a3844;
            Text {
                x: 32px;
                y: 28px;
                width: 496px;
                text: menu-title;
                font-size: 26px;
                font-weight: 600;
                color: white;
                overflow: elide;
            }
            Rectangle {
                x: 24px;
                y: 92px;
                width: 512px;
                height: 64px;
                border-radius: 12px;
                background: #26323d;
                Text {
                    text: menu-action;
                    font-size: 26px;
                    font-weight: 600;
                    color: #ffd54a;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: parent.width;
                    height: parent.height;
                }
            }
            Text {
                x: 32px;
                y: 176px;
                width: 496px;
                text: "Enter to apply · any other button to close";
                font-size: 18px;
                color: #7d8892;
                horizontal-alignment: center;
            }
        }
    }
}
