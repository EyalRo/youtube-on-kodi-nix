export struct EpisodeData {
    id: string,
    title: string,
    subtitle: string,
    art: image,
    has-art: bool,
    watched: bool,
    /// 0..1 of the way through, for the resume bar.
    progress: float,
}

export struct TileData {
    id: string,
    kind: string,
    title: string,
    subtitle: string,
    art: image,
    has-art: bool,
    /// Everything in it has been watched.
    viewed: bool,
}

export struct RowData {
    id: string,
    label: string,
    /// The column last selected in this row, restored when the focus comes back to it.
    col: int,
    tiles: [TileData],
}

export struct BtDevice {
    name: string,
    /// "Connected", "Paired" or "Available".
    status: string,
    /// 0 other device, 1 game controller, 2 8BitDo M30, 3 8BitDo Lite 2.
    kind: int,
    /// 0 available, 1 paired, 2 connected.
    state: int,
}

/// A drawing of one of the controllers we give pairing instructions for: model 2 is the black
/// 8BitDo M30 (six face buttons), model 3 the teal 8BitDo Lite 2 (four face buttons).
component ControllerArt inherits Rectangle {
    in property <int> model;
    property <color> body: model == 2 ? #1b1b1f : #2fa59a;
    property <color> edge: model == 2 ? #55555d : #5fd1c6;
    property <color> key: model == 2 ? #55555d : #17504b;
    width: 150px;
    height: 86px;
    border-radius: model == 2 ? 14px : 40px;
    background: body;
    border-width: 2px;
    border-color: edge;
    // The d-pad.
    Rectangle { x: 20px; y: 36px; width: 36px; height: 12px; background: key; border-radius: 3px; }
    Rectangle { x: 32px; y: 24px; width: 12px; height: 36px; background: key; border-radius: 3px; }
    if model == 2: Rectangle {
        // Six buttons in two rows of three.
        for i in 3: Rectangle { x: 88px + i * 20px; y: 24px; width: 14px; height: 14px; border-radius: 7px; background: #9a9aa4; }
        for i in 3: Rectangle { x: 88px + i * 20px; y: 46px; width: 14px; height: 14px; border-radius: 7px; background: #9a9aa4; }
    }
    if model == 3: Rectangle {
        // Four buttons in a diamond, two small ones in the middle.
        Rectangle { x: 108px; y: 20px; width: 14px; height: 14px; border-radius: 7px; background: #e8f7f5; }
        Rectangle { x: 108px; y: 52px; width: 14px; height: 14px; border-radius: 7px; background: #e8f7f5; }
        Rectangle { x: 92px; y: 36px; width: 14px; height: 14px; border-radius: 7px; background: #e8f7f5; }
        Rectangle { x: 124px; y: 36px; width: 14px; height: 14px; border-radius: 7px; background: #e8f7f5; }
        Rectangle { x: 66px; y: 60px; width: 8px; height: 8px; border-radius: 4px; background: key; }
        Rectangle { x: 80px; y: 60px; width: 8px; height: 8px; border-radius: 4px; background: key; }
    }
}

component Poster inherits Rectangle {
    in property <TileData> data;
    in property <bool> focused;
    in property <int> index;
    width: 200px;
    height: 300px;
    border-radius: 10px;
    clip: true;
    // A stable colour per position when there is no artwork.
    background: Colors.hsv(mod(index * 47, 360), 0.45, 0.35);

    if data.has-art: Image {
        source: data.art;
        width: parent.width;
        height: parent.height;
        image-fit: cover;
    }
    if !data.has-art: Text {
        text: data.title;
        wrap: word-wrap;
        font-size: 24px;
        color: white;
        width: parent.width - 24px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    if data.viewed: Rectangle {
        x: parent.width - 44px;
        y: 8px;
        width: 34px;
        height: 34px;
        border-radius: 17px;
        background: #000000a0;
        Text { text: "✓"; color: white; font-size: 22px; horizontal-alignment: center; vertical-alignment: center; }
    }
}

// A line icon drawn from SVG path commands on a 24x24 grid (no icon font needed).
component Glyph inherits Path {
    in property <color> tint: white;
    width: 40px;
    height: 40px;
    viewbox-width: 24;
    viewbox-height: 24;
    fill: transparent;
    stroke: tint;
    stroke-width: 1.8px;
    stroke-line-cap: round;
}

// One bar button: a glyph in a rounded square; yellow ring when focused, red when armed.
component BarButton inherits Rectangle {
    in property <bool> focused;
    in property <bool> armed;
    in property <string> commands;
    // A dot on the corner: something here wants attention (an upgrade is available).
    in property <bool> badge;
    width: 60px;
    height: 60px;
    border-radius: 14px;
    background: armed ? #b3261e : (focused ? #26323d : transparent);
    border-width: focused ? 4px : 0px;
    border-color: #ffd54a;
    Glyph {
        commands: root.commands;
        tint: root.focused || root.armed ? white : #7d8892;
    }
    if badge: Rectangle {
        x: parent.width - 20px;
        y: 6px;
        width: 14px;
        height: 14px;
        border-radius: 7px;
        background: #e50914;
        border-width: 2px;
        border-color: #0e1318;
    }
}

export component App inherits Window {
    in-out property <[RowData]> rows;
    in-out property <int> sel-row: 0;
    in-out property <int> sel-col: 0;
    callback activate(int, int);
    // Home: every row goes back to its first tile.
    callback home-reset();
    // "Show all": the full list of one row, as an overlay.
    in-out property <bool> all-open: false;
    in property <string> all-title;
    in property <[TileData]> all-items;
    in-out property <int> sel-all: 0;
    callback all-activate(int);
    callback quit();
    callback moved();
    callback power(string);
    callback arm(string);
    callback disarm(string, string);
    callback config();
    // Ask the back end to look for new videos now (the hourly timer does it otherwise).
    callback sync();
    // The show or channel page: season tabs (detail-focus 0) over the episodes of one season (1).
    in property <bool> detail;
    in property <string> detail-title;
    in-out property <string> detail-id: "";
    in property <[string]> seasons;
    in property <[EpisodeData]> episodes;
    in-out property <int> sel-season: 0;
    in-out property <int> sel-ep: 0;
    in-out property <int> detail-focus: 0;
    callback season-changed(int);
    callback play-episode(int);
    callback back();
    // The watched-toggle menu: one entry ("Mark watched"/"Mark unwatched").
    in property <bool> menu-open: false;
    in property <string> menu-title: "";
    in property <string> menu-action: "";
    callback menu();
    callback menu-activate();
    callback menu-close();
    // The settings page (top bar, first button): for now the appliance version.
    in property <string> version: "";
    // The newer version waiting to be installed; empty when the appliance is up to date.
    in property <string> available: "";
    in-out property <bool> settings-open: false;
    // Settings pages: 0 the main page, 1 the Bluetooth controllers page.
    in-out property <int> settings-page: 0;
    // The Controllers page. Selection 0 is the scan row; devices follow. `bt-actions` shows the
    // action list of the selected device; `bt-busy` ignores keys while BlueZ is pairing.
    in property <[BtDevice]> bt-devices;
    in property <bool> bt-available: true;
    in property <bool> bt-scanning: false;
    in-out property <bool> bt-busy: false;
    in-out property <string> bt-message: "";
    in-out property <int> bt-sel: 0;
    in-out property <bool> bt-actions: false;
    in-out property <int> bt-act-sel: 0;
    in property <string> bt-hint-m30: "";
    in property <string> bt-hint-lite2: "";
    in property <string> bt-again-m30: "";
    in property <string> bt-again-lite2: "";
    callback bt-open();
    callback bt-close();
    callback bt-scan();
    callback bt-pair(int);
    callback bt-connect(int);
    callback bt-disconnect(int);
    callback bt-forget(int);
    // Debug builds log every remote button the UI receives (the text of the key event).
    callback key-debug(string);
    // sel-row == -1 puts the focus on the top bar; bar-sel picks the button (0 sync, 1 settings,
    // 2 reboot, 3 shutdown). Reboot and shutdown need a second select ("armed") within 3 s. The bar
    // opens on settings, as it did before the sync button was added to its left.
    in-out property <int> bar-sel: 1;
    property <int> armed: -1;
    property <string> notice;
    // True from choosing a video until the display is handed over: a full-screen spinner that
    // swallows the remote.
    in-out property <bool> loading: false;
    property <int> spin: 0;

    background: #0e1318;
    forward-focus: fs;
    default-font-size: 22px;

    property <length> tile-w: 224px;
    property <length> row-h: 480px;

    // Moves to row `n` (-1 is the top bar). Each row remembers its column, so it shows the same
    // scroll position when the focus comes back to it.
    function goto-row(n: int) {
        if (sel-row >= 0) { rows[sel-row].col = sel-col; }
        sel-row = n;
        if (n >= 0) { sel-col = max(0, min(rows[n].col, rows[n].tiles.length - 1)); }
        moved();
    }

    // True while the top bar (settings, reboot, shutdown) has the focus, on either screen.
    property <bool> on-bar: detail ? detail-focus < 0 : sel-row < 0;

    // Back goes up one level: episodes -> season tabs -> the show list; from the top bar it
    // returns to the page below it. On the show list there is nowhere further up.
    public function go-back() {
        disarm-power("button");
        if (all-open) { all-open = false; return; }
        if (settings-open) {
            if (bt-actions) { bt-actions = false; }
            else if (settings-page == 1) { leave-controllers(); }
            else { settings-open = false; }
            return;
        }
        if (menu-open) { menu-close(); return; }
        if (detail) {
            if (detail-focus == 1) { detail-focus = 0; moved(); }
            else if (detail-focus < 0) { detail-focus = 0; moved(); }
            else { back(); moved(); }
        } else if (sel-row < 0) {
            if (rows.length > 0) { goto-row(0); }
        }
    }

    // Home goes to the top of the tree: out of any show page, onto the first row, every row
    // scrolled back to its start.
    public function go-home() {
        disarm-power("button");
        all-open = false;
        if (settings-open) {
            if (settings-page == 1) { leave-controllers(); }
            settings-open = false;
            return;
        }
        if (menu-open) { menu-close(); return; }
        if (detail) { back(); }
        home-reset();
        sel-row = rows.length > 0 ? 0 : -1;
        sel-col = 0;
        moved();
    }

    // Number of entries in the action list of the selected controller.
    function act-count() -> int {
        return bt-sel >= 1 && bt-sel <= bt-devices.length && bt-devices[bt-sel - 1].state == 0 ? 1 : 2;
    }

    function act-label(i: int) -> string {
        if (bt-sel < 1 || bt-sel > bt-devices.length) { return ""; }
        if (bt-devices[bt-sel - 1].state == 0) { return "Pair and connect"; }
        if (i == 1) { return "Forget"; }
        return bt-devices[bt-sel - 1].state == 1 ? "Connect" : "Disconnect";
    }

    function leave-controllers() {
        settings-page = 0;
        bt-actions = false;
        bt-close();
    }

    function bt-run-action() {
        bt-actions = false;
        if (bt-sel < 1 || bt-sel > bt-devices.length) { return; }
        bt-busy = true;
        bt-message = "Working…";
        if (bt-devices[bt-sel - 1].state == 0) { bt-pair(bt-sel - 1); }
        else if (bt-act-sel == 1) { bt-forget(bt-sel - 1); }
        else if (bt-devices[bt-sel - 1].state == 1) { bt-connect(bt-sel - 1); }
        else { bt-disconnect(bt-sel - 1); }
    }

    // Keys while the settings are open. The main page opens Controllers with select and closes on
    // any other button; the Controllers page moves with up/down, selects with Return, and goes back
    // a level with Back/Escape.
    function settings-key(text: string) {
        if (settings-page == 0) {
            if (text == Key.Return) { settings-page = 1; bt-sel = 0; bt-actions = false; bt-message = ""; bt-open(); }
            else { settings-open = false; }
            return;
        }
        if (text == Key.Home) { leave-controllers(); settings-open = false; return; }
        if (bt-busy) { return; }
        if (bt-actions) {
            if (text == Key.UpArrow) { if (bt-act-sel > 0) { bt-act-sel -= 1; moved(); } }
            else if (text == Key.DownArrow) { if (bt-act-sel < act-count() - 1) { bt-act-sel += 1; moved(); } }
            else if (text == Key.Return) { bt-run-action(); }
            else { bt-actions = false; }
            return;
        }
        if (text == Key.UpArrow) { if (bt-sel > 0) { bt-sel -= 1; moved(); } }
        else if (text == Key.DownArrow) { if (bt-sel < bt-devices.length) { bt-sel += 1; moved(); } }
        else if (text == Key.Return) {
            if (bt-sel == 0) { bt-scan(); }
            else if (bt-available && bt-sel <= bt-devices.length) { bt-actions = true; bt-act-sel = 0; }
        }
        else if (text == Key.Escape || text == Key.Backspace) { leave-controllers(); }
    }

    function disarm-power(why: string) {
        if (armed >= 0) { disarm(armed == 2 ? "reboot" : "poweroff", why); }
        armed = -1;
    }

    function bar-move(step: int) {
        if (bar-sel + step >= 0 && bar-sel + step <= 3) { bar-sel += step; moved(); }
    }

    function bar-activate() {
        if (bar-sel == 0) {
            sync();
            notice = "Checking for new videos…";
            notice-timer.running = true;
        } else if (bar-sel == 1) {
            settings-open = true;
            settings-page = 0;
            config();
        } else if (armed == bar-sel) {
            armed = -1;
            power(bar-sel == 2 ? "reboot" : "poweroff");
        } else {
            armed = bar-sel;
            arm(bar-sel == 2 ? "reboot" : "poweroff");
            arm-timer.running = true;
        }
    }

    fs := FocusScope {
        key-pressed(e) => {
            key-debug(e.text);
            if (loading) { return accept; }
            if (all-open) {
                if (e.text == Key.Home) { go-home(); }
                else if (e.text == Key.Backspace || e.text == Key.Escape) { go-back(); }
                else if (e.text == Key.UpArrow) { if (sel-all > 0) { sel-all -= 1; moved(); } }
                else if (e.text == Key.DownArrow) { if (sel-all < all-items.length - 1) { sel-all += 1; moved(); } }
                else if (e.text == Key.LeftArrow) { if (sel-all > 0) { sel-all = max(0, sel-all - 10); moved(); } }
                else if (e.text == Key.RightArrow) { if (sel-all < all-items.length - 1) { sel-all = min(all-items.length - 1, sel-all + 10); moved(); } }
                else if (e.text == Key.Return) { all-activate(sel-all); }
                return accept;
            }
            if (settings-open) { settings-key(e.text); return accept; }
            // Reboot and shutdown need a second select; any other button cancels.
            if (e.text != Key.Return && armed >= 0) { disarm-power("button"); }
            if (menu-open) {
                if (e.text == Key.Return) { menu-activate(); }
                else { menu-close(); }
                return accept;
            }
            if (e.text == Key.Home) { go-home(); return accept; }
            if (e.text == Key.Backspace) { go-back(); return accept; }
            if (detail) {
                if (e.text == Key.LeftArrow) {
                    if (on-bar) { bar-move(-1); }
                    else if (detail-focus == 0) {
                        if (sel-season > 0) { sel-season -= 1; season-changed(sel-season); moved(); }
                    } else if (sel-ep > 0) { sel-ep -= 1; moved(); }
                } else if (e.text == Key.RightArrow) {
                    if (on-bar) { bar-move(1); }
                    else if (detail-focus == 0) {
                        if (sel-season < seasons.length - 1) { sel-season += 1; season-changed(sel-season); moved(); }
                    } else if (sel-ep < episodes.length - 1) { sel-ep += 1; moved(); }
                } else if (e.text == Key.DownArrow) {
                    if (on-bar) { detail-focus = 0; moved(); }
                    else if (detail-focus == 0 && episodes.length > 0) { detail-focus = 1; moved(); }
                } else if (e.text == Key.UpArrow) {
                    if (detail-focus == 1) { detail-focus = 0; moved(); }
                    else if (detail-focus == 0) { detail-focus = -1; moved(); }
                } else if (e.text == Key.Return) {
                    if (on-bar) { bar-activate(); }
                    else if (detail-focus == 1) { play-episode(sel-ep); }
                    else if (episodes.length > 0) { detail-focus = 1; moved(); }
                } else if (e.text == Key.Escape) {
                    go-back();
                } else {
                    return reject;
                }
                return accept;
            }
            if (e.text == Key.RightArrow) {
                if (sel-row < 0) { bar-move(1); }
                else if (sel-col < rows[sel-row].tiles.length - 1) { sel-col += 1; moved(); }
            } else if (e.text == Key.LeftArrow) {
                if (sel-row < 0) { bar-move(-1); }
                else if (sel-col > 0) { sel-col -= 1; moved(); }
            } else if (e.text == Key.DownArrow) {
                if (sel-row < 0) {
                    if (rows.length > 0) { goto-row(0); }
                } else if (sel-row < rows.length - 1) { goto-row(sel-row + 1); }
            } else if (e.text == Key.UpArrow) {
                if (sel-row >= 0) { goto-row(sel-row - 1); }
            } else if (e.text == Key.Return) {
                if (sel-row >= 0) { activate(sel-row, sel-col); } else { bar-activate(); }
            } else if (e.text == Key.Escape) {
                quit();
            } else {
                return reject;
            }
            accept
        }
    }

    arm-timer := Timer {
        running: false;
        interval: 3s;
        triggered => {
            if (armed >= 0) { disarm(armed == 2 ? "reboot" : "poweroff", "timeout"); }
            armed = -1;
            self.running = false;
        }
    }
    notice-timer := Timer {
        running: false;
        interval: 2500ms;
        triggered => { notice = ""; self.running = false; }
    }

    // Top bar: glyph buttons on the right, a short notice on the left.
    Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: 80px;
        background: #121a21;
        // The wordmark, in a streaming-service red: heavy, widely spaced, with a dark offset
        // shadow for the embossed look. Hebrew, reading right to left.
        Text {
            x: 62px;
            y: 3px;
            text: "שמטפליקס";
            font-size: 46px;
            font-weight: 900;
            letter-spacing: 3px;
            color: #5c0a0e;
            vertical-alignment: center;
            height: parent.height;
        }
        Text {
            x: 60px;
            text: "שמטפליקס";
            font-size: 46px;
            font-weight: 900;
            letter-spacing: 3px;
            color: #e50914;
            vertical-alignment: center;
            height: parent.height;
        }
        Text {
            x: 330px;
            text: notice;
            font-size: 22px;
            color: #aab4bd;
            vertical-alignment: center;
            height: parent.height;
        }
        HorizontalLayout {
            x: root.width - 288px - 60px;
            y: 10px;
            width: 288px;
            height: 60px;
            spacing: 16px;
            BarButton {
                focused: on-bar && bar-sel == 0;
                // cloud with a down arrow: fetch new videos now
                commands: "M7 18 A4 4 0 0 1 6.5 10.1 A5.5 5.5 0 0 1 17.3 9 A4.5 4.5 0 0 1 17 18 H7 M12 11 V17 M9.5 14.5 L12 17 L14.5 14.5";
            }
            BarButton {
                focused: on-bar && bar-sel == 1;
                badge: available != "";
                // sliders
                commands: "M4 7 H6 M10 7 H20 M8 7 m-2 0 a2 2 0 1 0 4 0 a2 2 0 1 0 -4 0 M4 12 H14 M18 12 H20 M16 12 m-2 0 a2 2 0 1 0 4 0 a2 2 0 1 0 -4 0 M4 17 H8 M12 17 H20 M10 17 m-2 0 a2 2 0 1 0 4 0 a2 2 0 1 0 -4 0";
            }
            BarButton {
                focused: on-bar && bar-sel == 2;
                armed: armed == 2;
                // circular arrow
                commands: "M20 12 A8 8 0 1 1 17.66 6.34 M20 3.5 V8.5 H15";
            }
            BarButton {
                focused: on-bar && bar-sel == 3;
                armed: armed == 3;
                // power
                commands: "M12 3 V12 M7.2 6.2 A8 8 0 1 0 16.8 6.2";
            }
        }
    }

    // Show / channel page: the title, season tabs, then that season's episodes with thumbnails.
    if detail: Rectangle {
        x: 0;
        y: 80px;
        width: root.width;
        height: root.height - 80px;
        clip: true;

        Text {
            x: 60px;
            y: 24px;
            width: root.width - 120px;
            text: detail-title;
            font-size: 40px;
            font-weight: 700;
            color: white;
            overflow: elide;
        }
        Rectangle {
            x: 0;
            y: 96px;
            width: root.width;
            height: 56px;
            clip: true;
            for s[i] in seasons: Rectangle {
                x: 60px + (i - max(0, sel-season - 6)) * 190px;
                width: 176px;
                height: 52px;
                border-radius: 26px;
                background: i == sel-season ? (detail-focus == 0 ? #ffd54a : #38444f) : transparent;
                animate x { duration: 150ms; easing: ease-out; }
                Text {
                    text: s;
                    font-size: 24px;
                    font-weight: 600;
                    color: i == sel-season ? (detail-focus == 0 ? #0e1318 : white) : #7d8892;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: parent.width;
                    height: parent.height;
                }
            }
        }
        Rectangle {
            x: 60px - max(0, sel-ep - 3) * 360px;
            y: 190px;
            animate x { duration: 180ms; easing: ease-out; }
            for ep[ei] in episodes: Rectangle {
                x: ei * 360px;
                y: 0px;
                width: 360px;
                height: 330px;
                property <bool> focused: detail-focus == 1 && ei == sel-ep;
                Rectangle {
                    x: 8px;
                    y: parent.focused ? 4px : 10px;
                    width: 336px;
                    height: 189px;
                    border-radius: 10px;
                    clip: true;
                    background: Colors.hsv(mod(ei * 47, 360), 0.45, 0.35);
                    animate y { duration: 120ms; }
                    if ep.has-art: Image {
                        source: ep.art;
                        width: parent.width;
                        height: parent.height;
                        image-fit: cover;
                    }
                    if !ep.has-art: Text {
                        text: ep.title;
                        wrap: word-wrap;
                        font-size: 22px;
                        color: white;
                        width: parent.width - 24px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    if ep.progress > 0 && !ep.watched: Rectangle {
                        y: parent.height - 6px;
                        height: 6px;
                        width: parent.width * ep.progress;
                        background: #ffd54a;
                    }
                    if ep.watched: Rectangle {
                        x: parent.width - 44px;
                        y: 8px;
                        width: 34px;
                        height: 34px;
                        border-radius: 17px;
                        background: #000000a0;
                        Text { text: "✓"; color: white; font-size: 22px; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }
                Rectangle {
                    x: 4px;
                    y: parent.focused ? 0px : 6px;
                    width: 344px;
                    height: 197px;
                    border-radius: 14px;
                    border-width: parent.focused ? 5px : 0px;
                    border-color: #ffd54a;
                }
                Text {
                    x: 12px;
                    y: 214px;
                    width: 330px;
                    text: ep.title;
                    font-size: 22px;
                    wrap: word-wrap;
                    overflow: elide;
                    max-height: 64px;
                    color: parent.focused ? white : #aab4bd;
                }
                Text {
                    x: 12px;
                    y: 284px;
                    width: 330px;
                    text: ep.subtitle;
                    font-size: 18px;
                    color: #6f7b86;
                }
            }
        }
    }

    // Rows scroll inside a clipped viewport so only the focused row and the ones below show.
    if !detail: Rectangle {
        x: 0;
        y: 80px;
        width: root.width;
        height: root.height - 80px;
        clip: true;
    Rectangle {
        x: 0;
        y: -max(0, sel-row) * row-h;
        animate y { duration: 180ms; easing: ease-out; }
        for r[ri] in rows: Rectangle {
            y: ri * row-h;
            height: row-h;
            width: root.width;

            Text {
                x: 60px;
                y: 0px;
                text: r.label;
                font-size: 34px;
                font-weight: 700;
                color: ri == sel-row ? white : #7d8892;
            }
            Rectangle {
                x: 60px - max(0, (ri == sel-row ? sel-col : r.col) - 6) * tile-w;
                y: 60px;
                height: row-h - 60px;
                animate x { duration: 180ms; easing: ease-out; }
                for t[ti] in r.tiles: Rectangle {
                    x: ti * tile-w;
                    y: 0px;
                    width: tile-w;
                    height: row-h - 60px;
                    property <bool> focused: ri == sel-row && ti == sel-col;
                    Poster {
                        x: 12px;
                        y: parent.focused ? 4px : 10px;
                        data: t;
                        index: ti;
                        focused: parent.focused;
                        animate y { duration: 120ms; }
                    }
                    Rectangle {
                        x: 8px;
                        y: 6px - (parent.focused ? 4px : 0px);
                        width: 208px;
                        height: 308px;
                        border-radius: 14px;
                        border-width: parent.focused ? 5px : 0px;
                        border-color: #ffd54a;
                    }
                    Text {
                        x: 12px;
                        y: 318px;
                        width: 200px;
                        text: t.title;
                        font-size: 22px;
                        wrap: word-wrap;
                        overflow: elide;
                        max-height: 64px;
                        color: parent.focused ? white : #aab4bd;
                    }
                    Text {
                        x: 12px;
                        y: 384px;
                        width: 200px;
                        text: t.subtitle;
                        font-size: 18px;
                        color: #6f7b86;
                    }
                }
            }
        }
    }
    }

    // Show all: every item of one row as a list. Only the rows near the selection are built.
    if all-open: Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        background: #0e1318;
        Text {
            x: 60px;
            y: 20px;
            text: all-title;
            font-size: 34px;
            font-weight: 700;
            color: white;
        }
        Text {
            x: root.width - 360px;
            y: 28px;
            width: 300px;
            text: (sel-all + 1) + " / " + all-items.length;
            font-size: 22px;
            color: #7d8892;
            horizontal-alignment: right;
        }
        Rectangle {
            x: 0;
            y: 90px;
            width: root.width;
            height: root.height - 90px;
            clip: true;
            Rectangle {
                y: -max(0, sel-all - 4) * 72px;
                animate y { duration: 120ms; easing: ease-out; }
                for it[i] in all-items: Rectangle {
                    y: i * 72px;
                    width: root.width;
                    height: 72px;
                    if i >= sel-all - 8 && i <= sel-all + 16: Rectangle {
                        x: 40px;
                        width: root.width - 80px;
                        height: 64px;
                        border-radius: 10px;
                        background: i == sel-all ? #243241 : transparent;
                        border-width: i == sel-all ? 3px : 0px;
                        border-color: #ffd54a;
                        Text {
                            x: 24px;
                            width: parent.width - 480px;
                            height: parent.height;
                            text: it.title;
                            font-size: 26px;
                            overflow: elide;
                            vertical-alignment: center;
                            color: i == sel-all ? white : #aab4bd;
                        }
                        Text {
                            x: parent.width - 440px;
                            width: 360px;
                            height: parent.height;
                            text: it.subtitle;
                            font-size: 20px;
                            overflow: elide;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                            color: #6f7b86;
                        }
                        if it.viewed: Text {
                            x: parent.width - 60px;
                            width: 40px;
                            height: parent.height;
                            text: "✓";
                            font-size: 24px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            color: white;
                        }
                    }
                }
            }
        }
    }

    // Settings: the main page (version, upgrade, Controllers) and the Bluetooth controllers page.
    if settings-open: Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        background: #00000080;
        if settings-page == 0: Rectangle {
            x: (root.width - 560px) / 2;
            y: (root.height - 340px) / 2;
            width: 560px;
            height: 340px;
            border-radius: 20px;
            background: #16202a;
            border-width: 2px;
            border-color: #2a3844;
            Text {
                x: 32px;
                y: 28px;
                width: 496px;
                text: "Settings";
                font-size: 26px;
                font-weight: 600;
                color: white;
            }
            Text {
                x: 32px;
                y: 84px;
                width: 496px;
                text: "Installed version " + version;
                font-size: 26px;
                color: #ffd54a;
            }
            Text {
                x: 32px;
                y: 128px;
                width: 496px;
                text: available != "" ? "Upgrade available: " + available : "Up to date";
                font-size: 26px;
                color: available != "" ? #e50914 : #7d8892;
            }
            Rectangle {
                x: 32px;
                y: 200px;
                width: 496px;
                height: 56px;
                border-radius: 10px;
                background: #243442;
                border-width: 2px;
                border-color: #ffd54a;
                Text {
                    x: 20px;
                    text: "Controllers";
                    font-size: 26px;
                    color: white;
                    vertical-alignment: center;
                }
                Text {
                    x: 440px;
                    width: 36px;
                    text: "›";
                    font-size: 30px;
                    color: #ffd54a;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }
            }
            Text {
                x: 32px;
                y: 288px;
                width: 496px;
                text: "select: controllers · any other button closes";
                font-size: 18px;
                color: #7d8892;
                horizontal-alignment: center;
            }
        }
        if settings-page == 1: Rectangle {
            property <int> top: max(0, bt-sel - 7);
            x: (root.width - 1500px) / 2;
            y: (root.height - 860px) / 2;
            width: 1500px;
            height: 860px;
            border-radius: 20px;
            background: #16202a;
            border-width: 2px;
            border-color: #2a3844;
            Text {
                x: 40px;
                y: 28px;
                width: 800px;
                text: "Controllers";
                font-size: 30px;
                font-weight: 600;
                color: white;
            }
            if !bt-available: Text {
                x: 40px;
                y: 120px;
                width: 820px;
                text: bt-message;
                font-size: 26px;
                color: #e50914;
                wrap: word-wrap;
            }
            if bt-available: Rectangle {
                // Row 0: the scan action.
                if top == 0: Rectangle {
                    x: 40px;
                    y: 100px;
                    width: 820px;
                    height: 56px;
                    border-radius: 10px;
                    background: bt-sel == 0 ? #243442 : #1b2733;
                    border-width: 2px;
                    border-color: bt-sel == 0 ? #ffd54a : #2a3844;
                    Text {
                        x: 20px;
                        text: bt-scanning ? "Scanning… select to stop" : "Scan for controllers";
                        font-size: 26px;
                        color: bt-scanning ? #4cd964 : white;
                        vertical-alignment: center;
                    }
                }
                for d[i] in bt-devices: Rectangle {
                    visible: i + 1 >= top && i + 1 < top + 8;
                    x: 40px;
                    y: 100px + (i + 1 - top) * 64px;
                    width: 820px;
                    height: 56px;
                    border-radius: 10px;
                    background: bt-sel == i + 1 ? #243442 : #1b2733;
                    border-width: 2px;
                    border-color: bt-sel == i + 1 ? #ffd54a : #2a3844;
                    Text {
                        x: 20px;
                        width: 560px;
                        text: d.name;
                        font-size: 26px;
                        color: d.kind == 0 ? #7d8892 : white;
                        overflow: elide;
                        vertical-alignment: center;
                    }
                    Text {
                        x: 600px;
                        width: 200px;
                        text: d.status;
                        font-size: 24px;
                        color: d.state == 2 ? #4cd964 : d.state == 1 ? #ffd54a : #9aa7b2;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                    }
                }
                if bt-devices.length == 0: Text {
                    x: 40px;
                    y: 180px;
                    width: 820px;
                    text: "No controllers yet. Select Scan, then put a controller into pairing mode (see the right).";
                    font-size: 22px;
                    color: #7d8892;
                    wrap: word-wrap;
                }
                // The action list of the selected device.
                if bt-actions: Rectangle {
                    x: 380px;
                    y: 100px + (bt-sel - top) * 64px + 44px;
                    width: 440px;
                    height: act-count() * 60px + 16px;
                    border-radius: 12px;
                    background: #0e1318;
                    border-width: 2px;
                    border-color: #ffd54a;
                    for i in act-count(): Rectangle {
                        x: 8px;
                        y: 8px + i * 60px;
                        width: 424px;
                        height: 52px;
                        border-radius: 8px;
                        background: bt-act-sel == i ? #243442 : transparent;
                        Text {
                            x: 16px;
                            text: act-label(i);
                            font-size: 24px;
                            color: act-label(i) == "Forget" ? #e50914 : white;
                            vertical-alignment: center;
                        }
                    }
                }
            }
            // How to put each known controller into pairing mode.
            Text {
                x: 900px;
                y: 28px;
                width: 568px;
                text: "Pairing mode";
                font-size: 26px;
                font-weight: 600;
                color: white;
            }
            Rectangle {
                x: 900px;
                y: 100px;
                width: 568px;
                height: 300px;
                border-radius: 14px;
                background: #1c2833;
                ControllerArt { x: 20px; y: 20px; model: 2; }
                Text { x: 190px; y: 36px; width: 360px; text: "8BitDo M30 (black)"; font-size: 24px; font-weight: 600; color: white; }
                Text { x: 20px; y: 130px; width: 528px; text: bt-hint-m30; font-size: 21px; color: #c8d1d9; wrap: word-wrap; }
                Text { x: 20px; y: 240px; width: 528px; text: bt-again-m30; font-size: 19px; color: #7d8892; wrap: word-wrap; }
            }
            Rectangle {
                x: 900px;
                y: 424px;
                width: 568px;
                height: 300px;
                border-radius: 14px;
                background: #1c2833;
                ControllerArt { x: 20px; y: 20px; model: 3; }
                Text { x: 190px; y: 36px; width: 360px; text: "8BitDo Lite 2 (teal)"; font-size: 24px; font-weight: 600; color: white; }
                Text { x: 20px; y: 130px; width: 528px; text: bt-hint-lite2; font-size: 21px; color: #c8d1d9; wrap: word-wrap; }
                Text { x: 20px; y: 240px; width: 528px; text: bt-again-lite2; font-size: 19px; color: #7d8892; wrap: word-wrap; }
            }
            Text {
                x: 40px;
                y: 760px;
                width: 1420px;
                text: bt-message;
                font-size: 24px;
                color: #ffd54a;
                overflow: elide;
            }
            Text {
                x: 40px;
                y: 810px;
                width: 1420px;
                text: bt-busy ? "Please wait…" : "select: choose · back: previous page";
                font-size: 18px;
                color: #7d8892;
            }
        }
    }

    // Watched-toggle menu: a modal single-entry dialog. Enter selects; anything
    // else closes it.
    if menu-open: Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        background: #00000080;
        Rectangle {
            x: (root.width - 560px) / 2;
            y: (root.height - 220px) / 2;
            width: 560px;
            height: 220px;
            border-radius: 20px;
            background: #16202a;
            border-width: 2px;
            border-color: #2a3844;
            Text {
                x: 32px;
                y: 28px;
                width: 496px;
                text: menu-title;
                font-size: 26px;
                font-weight: 600;
                color: white;
                overflow: elide;
            }
            Rectangle {
                x: 24px;
                y: 92px;
                width: 512px;
                height: 64px;
                border-radius: 12px;
                background: #26323d;
                Text {
                    text: menu-action;
                    font-size: 26px;
                    font-weight: 600;
                    color: #ffd54a;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: parent.width;
                    height: parent.height;
                }
            }
            Text {
                x: 32px;
                y: 176px;
                width: 496px;
                text: "Enter to apply · any other button to close";
                font-size: 18px;
                color: #7d8892;
                horizontal-alignment: center;
            }
        }
    }

    spin-timer := Timer {
        running: loading;
        interval: 90ms;
        triggered => { spin = mod(spin + 1, 8); }
    }

    if loading: Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        background: #0e1318;
        for i in 8: Rectangle {
            width: 20px;
            height: 20px;
            border-radius: 10px;
            x: root.width / 2 - 10px + 44px * cos(45deg * i);
            y: root.height / 2 - 10px + 44px * sin(45deg * i);
            background: white;
            opacity: 1.0 - mod(spin - i + 8, 8) * 0.12;
        }
    }
}
