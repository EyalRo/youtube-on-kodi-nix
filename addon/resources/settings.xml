<?xml version="1.0" encoding="UTF-8"?>
<settings>
    <setting id="max_height" type="labelenum" label="Maximum video quality (pixels high)" values="360|480|720|1080|1440|2160" default="1080" />
    <setting id="playback_engine" type="labelenum" label="Playback engine" values="inputstream.adaptive|ffmpeg" default="inputstream.adaptive" />
    <setting id="refresh_hours" type="slider" label="Cache duration (hours)" range="1,168" option="int" default="24" />
    <setting id="channel_expire_days" type="slider" label="Channel cache expiry (days)" range="1,365" option="int" default="30" />
    <setting id="retry_cooldown_minutes" type="slider" label="Retry cooldown after failure (minutes)" range="1,120" option="int" default="10" />
    <setting id="search_max_age_days" type="slider" label="Search cache max age (days)" range="1,90" option="int" default="7" />
    <setting id="search_max_files" type="slider" label="Max search cache files (0 = unlimited)" range="0,500" option="int" default="50" />
    <setting id="library_dir" type="text" label="Library folder for exported channels (empty = add-on profile)" default="" />
    <setting id="library_max_videos" type="slider" label="Videos exported per channel" range="5,500" option="int" default="50" />
    <setting id="games_dir" type="text" label="ROM folder (one subfolder per system, e.g. NES, Genesis)" default="" />
    <setting id="media_refresh_minutes" type="slider" label="Refresh channel export and games scan every (minutes, 0 = off)" range="0,15,1440" option="int" default="0" />
    <setting id="catalog_cache_seconds" type="slider" label="Reuse the home rows catalog for (seconds, 0 = never)" range="0,5,300" option="int" default="20" />
</settings>
